{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "admin.css", "use": "@vercel/static" },
    { "src": "admin.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/admin.css", "dest": "/admin.css" },
    { "src": "/admin.js", "dest": "/admin.js" },
    { "src": "/admin.html", "dest": "/admin.html" },
    { "src": "/", "dest": "/index.html" }
  ]
}
